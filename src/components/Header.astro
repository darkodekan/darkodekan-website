---
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";

import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);

const normalizedPath =
  relativePath === "/"
    ? "/"
    : `${relativePath.replace(/\/+$/, "")}/`;

const isSerbianPage = normalizedPath.startsWith("/sr/");

const pathWithoutTrailingSlash =
  normalizedPath.endsWith("/") && normalizedPath !== "/"
    ? normalizedPath.slice(0, -1)
    : normalizedPath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const addBase = (path: string) => `${basePath}${path}`;
const homeURL = addBase(isSerbianPage ? "/sr/" : "/");

const languagePairs: Record<string, string> = {
  "/": "/sr/",
  "/sr/": "/",

  "/tutoring/": "/sr/privatni-casovi/",
  "/sr/privatni-casovi/": "/tutoring/",

  "/tutoring/programming/":
    "/sr/privatni-casovi/programiranje/",
  "/sr/privatni-casovi/programiranje/":
    "/tutoring/programming/",

  "/tutoring/mathematics/":
    "/sr/privatni-casovi/matematika/",
  "/sr/privatni-casovi/matematika/":
    "/tutoring/mathematics/",

  "/programming/": "/sr/privatni-casovi/programiranje/",
  "/sr/programiranje/": "/programming/",

  "/mathematics/": "/sr/privatni-casovi/matematika/",
  "/sr/matematika/": "/mathematics/",
};

const alternatePath = languagePairs[normalizedPath];
const languageURL = alternatePath ? addBase(alternatePath) : undefined;
const languageLabel = isSerbianPage ? "EN" : "SR";
const languageHreflang = isSerbianPage ? "en" : "sr-RS";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-1.5 text-sm backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout w-full">
  <div
    class="border-border bg-background/80 sticky top-0 z-40 flex w-full items-center justify-between border-b py-3.5 backdrop-blur-md sm:py-4.5"
  >
    <!-- Logo / Brand -->
    <a
      href={homeURL}
      class="group flex items-center gap-3 transition-opacity hover:opacity-80"
      aria-label={
        isSerbianPage
          ? "Darko Dekan — početna stranica"
          : "Darko Dekan homepage"
      }
    >
      <img
        src={`${import.meta.env.BASE_URL}favicon.svg`}
        alt=""
        width="40"
        height="40"
        class="shrink-0 transition-transform group-hover:scale-105"
      />
      <span class="text-lg font-bold tracking-tight">Darko Dekan</span>
    </a>

    <!-- Mobile Menu Toggle -->
    <button
      id="menu-btn"
      class="focus-outline rounded-lg p-2 transition-colors sm:hidden"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="menu-items"
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
    >
      <IconX id="close-icon" class="size-6 hidden" />
      <IconMenuDeep id="menu-icon" class="size-6" />
    </button>

    <!-- Desktop Navigation Links -->
    <nav
      id="menu-items"
      class="bg-background/95 sm:bg-transparent absolute top-full right-0 left-0 hidden flex-col border-b border-border p-5 shadow-xl sm:static sm:flex sm:flex-row sm:items-center sm:gap-x-2.5 sm:border-b-0 sm:p-0 sm:shadow-none backdrop-blur-lg sm:backdrop-blur-none"
      aria-label={
        isSerbianPage ? "Glavna navigacija" : "Main navigation"
      }
    >
      <ul class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-x-1.5">
        {
          isSerbianPage ? (
            <>
              <li>
                <a
                  href={addBase("/sr/privatni-casovi/")}
                  class:list={[
                    "rounded-lg px-3.5 py-2 text-sm font-medium transition-colors block",
                    {
                      "bg-accent/10 text-accent font-semibold":
                        normalizedPath === "/sr/privatni-casovi/",
                      "text-foreground/75 hover:bg-muted hover:text-foreground":
                        normalizedPath !== "/sr/privatni-casovi/",
                    },
                  ]}
                  aria-current={
                    normalizedPath === "/sr/privatni-casovi/"
                      ? "page"
                      : undefined
                  }
                >
                  Časovi
                </a>
              </li>
              <li>
                <a
                  href={addBase("/sr/privatni-casovi/matematika/")}
                  class:list={[
                    "rounded-lg px-3.5 py-2 text-sm font-medium transition-colors block",
                    {
                      "bg-accent/10 text-accent font-semibold":
                        normalizedPath.startsWith(
                          "/sr/privatni-casovi/matematika/"
                        ),
                      "text-foreground/75 hover:bg-muted hover:text-foreground":
                        !normalizedPath.startsWith(
                          "/sr/privatni-casovi/matematika/"
                        ),
                    },
                  ]}
                  aria-current={
                    normalizedPath.startsWith(
                      "/sr/privatni-casovi/matematika/"
                    )
                      ? "page"
                      : undefined
                  }
                >
                  Matematika
                </a>
              </li>
              <li>
                <a
                  href={addBase("/sr/privatni-casovi/programiranje/")}
                  class:list={[
                    "rounded-lg px-3.5 py-2 text-sm font-medium transition-colors block",
                    {
                      "bg-accent/10 text-accent font-semibold":
                        normalizedPath.startsWith(
                          "/sr/privatni-casovi/programiranje/"
                        ),
                      "text-foreground/75 hover:bg-muted hover:text-foreground":
                        !normalizedPath.startsWith(
                          "/sr/privatni-casovi/programiranje/"
                        ),
                    },
                  ]}
                  aria-current={
                    normalizedPath.startsWith(
                      "/sr/privatni-casovi/programiranje/"
                    )
                      ? "page"
                      : undefined
                  }
                >
                  Programiranje
                </a>
              </li>
            </>
          ) : (
            <>
              <li>
                <a
                  href={addBase("/tutoring/")}
                  class:list={[
                    "rounded-lg px-3.5 py-2 text-sm font-medium transition-colors block",
                    {
                      "bg-accent/10 text-accent font-semibold":
                        normalizedPath === "/tutoring/",
                      "text-foreground/75 hover:bg-muted hover:text-foreground":
                        normalizedPath !== "/tutoring/",
                    },
                  ]}
                  aria-current={
                    normalizedPath === "/tutoring/" ? "page" : undefined
                  }
                >
                  Tutoring
                </a>
              </li>
              <li>
                <a
                  href={addBase("/mathematics/")}
                  class:list={[
                    "rounded-lg px-3.5 py-2 text-sm font-medium transition-colors block",
                    {
                      "bg-accent/10 text-accent font-semibold":
                        normalizedPath === "/mathematics/" ||
                        normalizedPath.startsWith("/tutoring/mathematics/"),
                      "text-foreground/75 hover:bg-muted hover:text-foreground":
                        !(
                          normalizedPath === "/mathematics/" ||
                          normalizedPath.startsWith("/tutoring/mathematics/")
                        ),
                    },
                  ]}
                  aria-current={
                    normalizedPath === "/mathematics/" ||
                    normalizedPath.startsWith("/tutoring/mathematics/")
                      ? "page"
                      : undefined
                  }
                >
                  Mathematics
                </a>
              </li>
              <li>
                <a
                  href={addBase("/programming/")}
                  class:list={[
                    "rounded-lg px-3.5 py-2 text-sm font-medium transition-colors block",
                    {
                      "bg-accent/10 text-accent font-semibold":
                        normalizedPath === "/programming/" ||
                        normalizedPath.startsWith("/tutoring/programming/"),
                      "text-foreground/75 hover:bg-muted hover:text-foreground":
                        !(
                          normalizedPath === "/programming/" ||
                          normalizedPath.startsWith("/tutoring/programming/")
                        ),
                    },
                  ]}
                  aria-current={
                    normalizedPath === "/programming/" ||
                    normalizedPath.startsWith("/tutoring/programming/")
                      ? "page"
                      : undefined
                  }
                >
                  Programming
                </a>
              </li>
            </>
          )
        }
      </ul>

      <!-- Secondary Controls (Language Switcher & Theme Toggle) -->
      <div
        class="mt-3.5 flex items-center gap-2.5 border-t border-border pt-3.5 sm:mt-0 sm:border-t-0 sm:pt-0 sm:ms-4 sm:ps-4 sm:border-s sm:border-border/60"
      >
        {
          languageURL && (
            <a
              href={languageURL}
              class="focus-outline hover:bg-muted text-foreground/80 hover:text-foreground rounded-lg border border-border px-2.5 py-1.5 text-xs font-semibold tracking-wider transition-colors"
              hreflang={languageHreflang}
              lang={isSerbianPage ? "en" : "sr"}
              aria-label={
                isSerbianPage
                  ? "View this page in English"
                  : "Pogledaj ovu stranicu na srpskom"
              }
            >
              {languageLabel}
            </a>
          )
        }

        {
          features.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="focus-outline hover:bg-muted text-foreground/80 hover:text-foreground flex size-9 items-center justify-center rounded-lg border border-border transition-colors"
              title={t.a11y.toggleTheme}
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon class="size-4 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90 absolute" />
              <IconSunHigh class="size-4 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0 absolute" />
            </button>
          )
        }
      </div>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn =
      document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) {
      return;
    }

    if (menuBtn.dataset.initialized === "true") {
      return;
    }

    menuBtn.dataset.initialized = "true";

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
      menuBtn.setAttribute("aria-label", isOpen ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("flex");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>