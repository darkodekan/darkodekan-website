---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { Icon } from "astro-icon/components";
import {
  CONTACT,
  getEmailURL,
  getViberURL,
  getWhatsAppURL,
} from "@/config/contact";

const canonicalURL = "https://darkodekan.com/tutoring/programming/python/";

const pageTitle = "Python Private Tutoring – 1-on-1 Online Lessons | Darko Dekan";

const pageDescription =
  "Private online Python tutoring: OOP, GUI (Tkinter, PyQT), Django, Flask, data analysis (pandas, numpy), machine learning, databases. Exam prep and project support.";

const whatsappURL = getWhatsAppURL(
  "Hi Darko, I'm interested in private Python tutoring."
);

const emailURL = getEmailURL("Private Python Tutoring");

// TODO: replace with real English-language, Python-specific testimonials once available.
const testimonials = [
 {
    quote: "Darko has been a great tutor for my son, teaching him across a number of university subjects. He’s very knowledgeable, genuine, patient, flexible and reliable, and has a calm and understanding approach. Highly recommended. Thanks, Darko!",
    name: "Mishy",
    context: "parent of a student",
    rating: 5,
    date: "2026-02-14",
  },
  {
    quote: "Clear, interesting, patient and with the right approach to students. Excellent communication and results. Highly recommended!",
    name: "Ana",
    context: "student",
    rating: 5,
    date: "2026-02-14",
  },
 {
    quote: "Professional with excellent knowledge in the field. He trained me in programming for 2 months and I got maximum points. Very flexible in terms of scheduling classes.",
    name: "Dushan",
    context: "student",
    rating: 5,
    date: "2026-08-15",
  },
  {
    quote: "Great experience with the teacher, quick and easy to arrange. Excellent classes and in line with the needs of the students... I recommend!",
    name: "Dimitrije",
    context: "student",
    rating: 5,
    date: "2026-03-10",
  },
 
  
];

const avgRating =
  testimonials.reduce((sum, t) => sum + t.rating, 0) / testimonials.length;

const reviewData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Python Private Tutoring",
  provider: {
    "@type": "Person",
    name: CONTACT.name,
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: avgRating.toFixed(1),
    reviewCount: testimonials.length,
  },
  review: testimonials.map((t) => ({
    "@type": "Review",
    itemReviewed: {
      "@type": "Service",
      name: "Python Private Tutoring",
    },
    reviewRating: {
      "@type": "Rating",
      ratingValue: t.rating,
      bestRating: 5,
    },
    author: {
      "@type": "Person",
      name: t.name,
    },
    datePublished: t.date,
    reviewBody: t.quote,
  })),
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Python Private Tutoring",
  description: pageDescription,
  url: canonicalURL,
  serviceType: "Online private programming tutoring – Python",
  areaServed: {
    "@type": "Country",
    name: "Serbia",
  },
  provider: {
    "@type": "Person",
    name: CONTACT.name,
    url: "https://darkodekan.com/",
  },
  isPartOf: {
    "@type": "Service",
    name: "Private Programming Tutoring",
    url: "https://darkodekan.com/tutoring/programming/",
  },
};

// FAQ content is deliberately tool/library-specific and distinct from the
// parent /tutoring/programming/ page's higher-level FAQ, to avoid duplicate
// FAQPage schema across pages — mirrors the pattern used on the Serbian site.
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is Python tutoring suitable for complete beginners?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, lessons start from the fundamentals and build up at your own pace, whether this is your first programming language or you're coming from another one.",
      },
    },
    {
      "@type": "Question",
      name: "Which Python libraries and topics do you cover?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "I cover OOP and metaprogramming, GUI development with Tkinter and PyQT, web development with Django, Flask and Bottle, REST APIs, data analysis and machine learning (pandas, numpy, matplotlib, plotly, scipy, scikit-learn), databases (MySQL, PostgreSQL, SQLite), and mobile app development using the Kivy library.",
      },
    },
    {
      "@type": "Question",
      name: "How does an online Python lesson work?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Lessons run over a video call with computer remote control, we both can type code in real time, work through examples together, and get code and notes from the session afterward to review on your own.",
      },
    },
    {
      "@type": "Question",
      name: "Do you help with university projects and exams in Python?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, I help with exam and coursework preparation, assign and review practice projects, and can also build a project with you if you need hands-on support.",
      },
    },
    /*
    {
      "@type": "Question",
      name: "How much does a Python lesson cost?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Python lessons are priced the same as other languages: around 15 EUR for 60 minutes, with a better-value option around 21 EUR for 90 minutes. Exact pricing and scheduling are agreed after a short conversation about your goals.",
      },
      
    },*/
  ],
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://darkodekan.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Tutoring",
      item: "https://darkodekan.com/tutoring/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Programming",
      item: "https://darkodekan.com/tutoring/programming/",
    },
    {
      "@type": "ListItem",
      position: 4,
      name: "Python",
      item: canonicalURL,
    },
  ],
};
---

<Layout
  lang="en"
  dir="ltr"
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  ogImage="/images/python_tutoring.jpg"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link
      rel="alternate"
      hreflang="sr-Latn"
      href="https://darkodekan.com/sr/privatni-casovi/programiranje/python/"
    />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <meta property="og:locale" content="en_US" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbData)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(reviewData)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqData)}
    />
  </Fragment>

  <Header />

  <nav aria-label="Breadcrumb" class="mx-auto max-w-3xl px-4 pt-6 sm:px-6">
    <ol class="text-muted-foreground flex flex-wrap items-center gap-1 text-sm">
      <li>
        <a href="/" class="hover:text-accent">Home</a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/tutoring/" class="hover:text-accent">Tutoring</a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/tutoring/programming/" class="hover:text-accent">Programming</a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-foreground font-medium">Python</li>
    </ol>
  </nav>

  <Main
    pageTitle="Python Private Tutoring — Online 1-on-1 Lessons"
    pageDesc="Private online Python lessons, from the fundamentals to advanced areas like web development, data analysis, and machine learning."
    class="app-prose pt-10 sm:pt-14"
  >
    <figure class="not-prose mb-10">
      <img
        src="/images/python_tutoring.jpg"
        alt="Private online Python tutoring — OOP, Django, Flask, data analysis"
        width="1200"
        height="675"
        loading="eager"
        fetchpriority="high"
        class="border-border w-full rounded-xl border object-cover"
      />

      <figcaption class="text-muted-foreground mt-2 text-center text-sm">
        Private online Python lessons — from the basics to Django, Flask, pandas, and machine learning.
      </figcaption>
    </figure>

    <section
      class="not-prose border-border bg-muted/20 mb-10 rounded-xl border p-6 sm:p-8"
    >
      <p class="m-0 text-lg leading-relaxed">
        Learn Python with one-on-one explanations, practical examples,
        and exercises matched to your level — from your first line of
        code to web apps and data analysis.
      </p>

      <ul class="mt-5 grid gap-2 sm:grid-cols-2">
        <li>✓ Thorough coverage from the ground up</li>
        <li>✓ Online lessons</li>
        <li>✓ Exam and coursework prep</li>
        <li>✓ Project work and code review</li>
      </ul>

      <div
        class="mt-7 grid gap-3 sm:grid-cols-2"
        aria-label="Contact options"
      >
        <a
          href={whatsappURL}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-accent text-accent-foreground hover:bg-accent/90 flex min-h-14 items-center justify-center gap-3 rounded-lg px-5 py-3 font-semibold transition-colors"
          aria-label={`Message on WhatsApp: ${CONTACT.phoneDisplay}`}
        >
          <Icon name="simple-icons:whatsapp" class="size-6 shrink-0" aria-hidden="true" />
          <span>WhatsApp</span>
        </a>

        <a
          href={getViberURL()}
          class="border-border hover:border-accent hover:text-accent flex min-h-14 items-center justify-center gap-3 rounded-lg border px-5 py-3 font-semibold transition-colors"
          aria-label={`Message on Viber: ${CONTACT.phoneDisplay}`}
        >
          <Icon name="simple-icons:viber" class="size-6 shrink-0" aria-hidden="true" />
          <span>Viber</span>
        </a>
      </div>
    </section>

    <!-- Short, Python-specific credibility line rather than a full duplicate -->
    <!-- of the "About me" bio on the parent /tutoring/programming/ page, to -->
    <!-- avoid duplicate content. Links back to the parent for the full bio. -->
    <section
      class="not-prose border-border mb-12 rounded-xl border p-6 sm:p-8"
    >
      <div class="grid gap-6 sm:grid-cols-[auto_1fr] sm:items-center">
        <img
          src="/images/profile-pic.png"
          alt="Darko Dekan, Python tutor"
          width="140"
          height="140"
          loading="lazy"
          class="border-border mx-auto size-28 rounded-full border object-cover sm:mx-0 sm:size-32"
        />

        <div>
          <h2 class="mt-0 text-xl font-semibold">About me</h2>

          <!-- TODO: replace with real Python-specific experience details -->
          <p class="mb-2">
            I use Python professionally and have been teaching it for
            more than 8 years, working with students and developers on
            fundamentals, web development, and data analysis.
          </p>

          <p class="mb-0 text-sm">
            <a
              href="/tutoring/programming/"
              class="text-accent font-medium hover:underline"
            >
              Read more about my background and the other languages I teach →
            </a>
          </p>
        </div>
      </div>
    </section>

    <h2>Who is Python tutoring for?</h2>

    <p>
      Lessons are suited to beginners, high school students, university
      students, and anyone who wants to learn Python or sharpen their
      practical skills — whether this is your first programming
      language or you're switching from another one.
    </p>

    <ul>
      <li>beginners learning to program for the first time;</li>
      <li>students preparing for a Python exam or coursework;</li>
      <li>students who need help with school material;</li>
      <li>people who want to learn data analysis or machine learning;</li>
      <li>anyone building a web app or API;</li>
      <li>students who need a project or assignment explained.</li>
    </ul>

    <h2>Python topics covered in lessons</h2>

    <div class="not-prose my-7 grid gap-4 sm:grid-cols-2">
      <section class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors">
        <div class="mb-4 flex items-center gap-3">
          <span class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg">
            <Icon name="tabler:code" class="size-6" aria-hidden="true" />
          </span>
          <h3 class="text-accent m-0 text-xl font-semibold">Fundamentals & OOP</h3>
        </div>
        <p class="mb-0">
          Python from the ground up, functions, classes and objects,
          inheritance, object-oriented programming, and
          metaprogramming.
        </p>
      </section>

      <section class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors">
        <div class="mb-4 flex items-center gap-3">
          <span class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg">
            <Icon name="tabler:layout-dashboard" class="size-6" aria-hidden="true" />
          </span>
          <h3 class="text-accent m-0 text-xl font-semibold">GUI development</h3>
        </div>
        <p class="mb-0">
          Building desktop apps with a graphical interface using
          Tkinter and PyQT.
        </p>
      </section>

      <section class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors">
        <div class="mb-4 flex items-center gap-3">
          <span class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg">
            <Icon name="tabler:world-www" class="size-7" aria-hidden="true" />
          </span>
          <h3 class="text-accent m-0 text-xl font-semibold">Web development</h3>
        </div>
        <p class="mb-0">
          Django, Flask, and Bottle, building REST APIs, and connecting
          a frontend to a Python backend.
        </p>
      </section>

      <section class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors">
        <div class="mb-4 flex items-center gap-3">
          <span class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg">
            <Icon name="tabler:chart-dots" class="size-7" aria-hidden="true" />
          </span>
          <h3 class="text-accent m-0 text-xl font-semibold">Data analysis & ML</h3>
        </div>
        <p class="mb-0">
          Data science and machine learning with pandas, numpy,
          matplotlib, plotly, scipy, and scikit-learn.
        </p>
      </section>

      <section class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors">
        <div class="mb-4 flex items-center gap-3">
          <span class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg">
            <Icon name="tabler:database" class="size-7" aria-hidden="true" />
          </span>
          <h3 class="text-accent m-0 text-xl font-semibold">Databases</h3>
        </div>
        <p class="mb-0">
          Working with databases from Python — MySQL, PostgreSQL, and
          SQLite.
        </p>
      </section>

      <section class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors">
        <div class="mb-4 flex items-center gap-3">
          <span class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg">
            <Icon name="tabler:device-mobile" class="size-7" aria-hidden="true" />
          </span>
          <h3 class="text-accent m-0 text-xl font-semibold">Mobile apps</h3>
        </div>
        <p class="mb-0">
          Building Android and iOS apps with the Kivy Python library.
        </p>
      </section>
    </div>

    <!-- Dedicated "how classes work" section using the specific tools proven -->
    <!-- to work in the original Serbian ad, adapted for an English audience. -->
    <h2>How online Python lessons work</h2>

    <ol>
      <li>
        Lessons run over a <strong>video call</strong> (Google Meet,
        Discord, or Zoom).
      </li>

      <li>
        We share screens using <strong>AnyDesk</strong> or &nbsp;<strong>TeamViewer</strong> — you can connect to my computer and
        you can type code as well with me.
      </li>

      <li>
        After the lesson, I share the code and examples from the
        session so you can review and practice on your own.
      </li>

      <li>
        When useful, I assign a project, review your work, and give
        feedback on what to improve.
      </li>
    </ol>

    <p>
      The goal isn't just to hand you a finished solution. What matters
      is that you understand the process, so you can solve similar
      problems on your own after the lesson.
    </p>
    <section class="not-prose border-border bg-muted/20 rounded-xl border p-6 sm:p-8 my-12">
      <div class="mx-auto mb-8 max-w-xl text-center">
        <h2 class="mt-0 mb-2 text-2xl font-bold">Python Lesson Pricing</h2>
        <p class="text-muted-foreground text-sm m-0">
          Transparent rates for 1-on-1 lessons, bug fixes, and exam prep. Multi-lesson packages and weekly support available after your first session.
        </p>
      </div>

      <div class="mx-auto grid max-w-3xl gap-6 md:grid-cols-2">
        <!-- Single 60-Min Lesson -->
        <div class="border-border bg-card text-card-foreground flex flex-col justify-between rounded-xl border p-6 shadow-sm">
          <div>
            <h3 class="mt-0 text-lg font-semibold">Standard Lesson</h3>
            <p class="text-muted-foreground mt-1 mb-4 text-xs">For specific bug fixes, concept reviews, and single assignments</p>
            <div class="my-4 flex items-baseline gap-1">
              <span class="text-foreground text-3xl font-extrabold">20 USD</span>
              <span class="text-muted-foreground text-sm">/ 60 min</span>
            </div>
            <ul class="text-sm mb-6 space-y-2.5 p-0 list-none">
              <li class="flex items-center gap-2">✓ 1-on-1 live video call & screen share</li>
              <li class="flex items-center gap-2">✓ Full session code & written notes</li>
              <li class="flex items-center gap-2">✓ Real-time code debugging</li>
            </ul>
          </div>
          <a
            href={whatsappURL}
            target="_blank"
            rel="noopener noreferrer"
            class="border-border hover:border-accent hover:text-accent flex min-h-11 w-full items-center justify-center rounded-lg border text-sm font-semibold transition-colors text-center"
          >
            Book 60 Min
          </a>
        </div>

        <!-- 90-Min Sprint (Highlighted) -->
        <div class="border-accent bg-card text-card-foreground relative flex flex-col justify-between rounded-xl border-2 p-6 shadow-md">
          <span class="bg-accent text-accent-foreground absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-3 py-0.5 text-xs font-bold uppercase tracking-wider">Most Popular</span>
          <div>
            <h3 class="mt-0 text-lg font-semibold">Exam & Lab Sprint</h3>
            <p class="text-muted-foreground mt-1 mb-4 text-xs">Extended deep dive for complex topics and midterm prep</p>
            <div class="my-4 flex items-baseline gap-1">
              <span class="text-foreground text-3xl font-extrabold">28 USD</span>
              <span class="text-muted-foreground text-sm">/ 90 min</span>
            </div>
            <ul class="text-sm mb-6 space-y-2.5 p-0 list-none">
              <li class="flex items-center gap-2">✓ Extended 90-minute session</li>
              <li class="flex items-center gap-2">✓ OOP, Data Structures, or Django/Flask</li>
              <li class="flex items-center gap-2">✓ Targeted exam & lab coursework prep</li>
              <li class="flex items-center gap-2">✓ Post-lesson code review & project guidance</li>
            </ul>
          </div>
          <a
            href={whatsappURL}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent text-accent-foreground hover:bg-accent/90 flex min-h-11 w-full items-center justify-center rounded-lg text-sm font-semibold transition-colors text-center"
          >
            Book 90 Min
          </a>
        </div>
      </div>

      <div class="text-muted-foreground mt-6 text-center text-xs">
        <p class="mb-1">Looking for multi-lesson bundles (e.g. 4-class packages) or ongoing weekly mentorship?</p>
        <p class="m-0">We can discuss customized package rates and schedules at the end of your first lesson.</p>
      </div>
    </section>
    <!-- 
    <section
      class="not-prose border-border bg-muted/20 my-12 rounded-xl border p-6 sm:p-8"
    >
      <h2 class="mt-0 text-xl font-semibold">Python lesson pricing</h2>

      <p class="mb-2 text-lg">
        Pricing is the same as for other languages, starting
        at&nbsp;<strong>~15 EUR</strong> for 60 minutes, with a
        better-value option at&nbsp;<strong>~21 EUR</strong> for 90
        minutes.
      </p>

      <p class="text-muted-foreground mb-0 text-sm">
        Exact pricing and a suggested schedule are shared after a short
        conversation about your goals.
      </p>
    </section>
-->

    <section class="not-prose my-12">
      <h2 class="mb-6 text-xl font-semibold">What students say</h2>

      <div class="grid gap-4 sm:grid-cols-2">
        {testimonials.map((t) => (
          <blockquote class="border-border flex h-full flex-col justify-between rounded-lg border p-5">
            <p class="mb-4 text-sm leading-relaxed italic">"{t.quote}"</p>
            <footer class="text-muted-foreground text-sm">
              <span class="font-semibold not-italic">{t.name}</span>
              {t.context && <span> — {t.context}</span>}
            </footer>
          </blockquote>
        ))}
      </div>
    </section>

    <h2>What to send before your first lesson</h2>

    <p>In your first message, let me know:</p>

    <ul>
      <li>which area of Python you're learning or want to learn;</li>
      <li>your school or university, if relevant;</li>
      <li>whether you have prior experience with Python or another language;</li>
      <li>any upcoming exam, coursework, or project deadline;</li>
      <li>whether you need help with a specific task or general learning.</li>
    </ul>

    <section class="not-prose mt-12 rounded-xl border p-6 sm:p-8">
      <h2 class="mt-0 text-2xl font-semibold">Interested in a Python lesson?</h2>

      <p class="mt-3 mb-6">
        Send me what you're currently learning and what you'd like to
        achieve. I'll reply with a suggested approach and available
        times.
      </p>

      <div
        class="mt-7 grid gap-3 sm:grid-cols-2"
        aria-label="Contact options"
      >
        <a
          href={whatsappURL}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-accent text-accent-foreground hover:bg-accent/90 flex min-h-14 items-center justify-center gap-3 rounded-lg px-5 py-3 font-semibold transition-colors"
          aria-label={`Message on WhatsApp: ${CONTACT.phoneDisplay}`}
        >
          <Icon name="simple-icons:whatsapp" class="size-6 shrink-0" aria-hidden="true" />
          <span>WhatsApp</span>
        </a>

        <a
          href={getViberURL()}
          class="border-border hover:border-accent hover:text-accent flex min-h-14 items-center justify-center gap-3 rounded-lg border px-5 py-3 font-semibold transition-colors"
          aria-label={`Message on Viber: ${CONTACT.phoneDisplay}`}
        >
          <Icon name="simple-icons:viber" class="size-6 shrink-0" aria-hidden="true" />
          <span>Viber</span>
        </a>
      </div>
    </section>
  </Main>

  <Footer />
</Layout>