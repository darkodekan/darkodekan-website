---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { Icon } from "astro-icon/components";
import {
  CONTACT,
  getEmailURL,
  getViberURL,
  getWhatsAppURL,
} from "@/config/contact";

const canonicalURL =
  "https://darkodekan.com/sr/privatni-casovi/programiranje/";

const pageTitle =
  "Privatni časovi programiranja – Python, Java, C/C++/C#, JavaScript | Darko Dekan";

const pageDescription =
  "Privatni online časovi programiranja za početnike, učenike i studente. Python, Java, C/C++/C#, JavaScript, algoritmi, OOP, veb aplikacije, priprema kolokvijuma, ispita i praktični projekti.";

const whatsappURL = getWhatsAppURL(
  "Zdravo Darko, zanimaju me privatni časovi programiranja."
);

const emailURL = getEmailURL(
  "Privatni časovi programiranja"
);

// TODO: replace with your real testimonials (name + optional context, e.g. "student, FTN")
const testimonials = [
  {
    quote: "Profesor ima izuzetno znanje i sjajan način objašnjavanja. Vrlo je strpljiv i uvek se potrudi da sve bude jasno i razumljivo. Lekcije su prijatne, zanimljive i korisne, za svaku preporuku!",
    name: "Irena",
    context: "student",
    rating: 5,
  },
  {
    quote: "Koncizan, jasan, sve najbolje.",
    name: "Olivera",
    context: "majka učenice",
    rating: 5,
  },
  {
    quote: "Baš je zadovoljan tvojim načinom predavanja ove godine, kao i ja. Ok si bio i prošle godine, ali sada si baš profi. Drago mi je što učim ovaj predmet sa tobom.",
    name: "Ana Marija",
    context: "student",
    rating: 5,
  },
];

const avgRating =
  testimonials.reduce((sum, t) => sum + t.rating, 0) / testimonials.length;

const reviewData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Privatni časovi programiranja",
  provider: {
    "@type": "Person",
    name: CONTACT.name,
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: avgRating.toFixed(1),
    reviewCount: testimonials.length,
  },
  review: testimonials.map((t) => ({
    "@type": "Review",
    reviewRating: {
      "@type": "Rating",
      ratingValue: t.rating,
      bestRating: 5,
    },
    author: {
      "@type": "Person",
      name: t.name,
    },
    reviewBody: t.quote,
  })),
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Privatni časovi programiranja",
  description: pageDescription,
  url: canonicalURL,
  serviceType: "Online privatni časovi programiranja",
  areaServed: {
    "@type": "Country",
    name: "Serbia",
  },
  provider: {
    "@type": "Person",
    name: CONTACT.name,
    url: "https://darkodekan.com/",
  },
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Početna",
      item: "https://darkodekan.com/sr/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Privatni časovi",
      item: "https://darkodekan.com/sr/privatni-casovi/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Programiranje",
      item: canonicalURL,
    },
  ],
};
---

<Layout
  lang="sr-Latn"
  dir="ltr"
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  ogImage="/images/privatni_casovi_banner.png"

>
  <Fragment slot="head">
    <link rel="alternate" hreflang="sr-Latn" href={canonicalURL} />
   <link rel="alternate" hreflang="en" href="https://darkodekan.com/tutoring/programming/" />
   <link rel="alternate" hreflang="x-default" href="https://darkodekan.com/tutoring/programming/" />
    <meta property="og:locale" content="sr_RS" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

     <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbData)}
    />

    <script
    type="application/ld+json"
    set:html={JSON.stringify(reviewData)}
  />
  </Fragment>

  <Header />

  <Main
    pageTitle="Privatni časovi programiranja - Python, Java, C/C++/C#, JavaScript"
    pageDesc="Privatni online časovi prilagođeni vašem predznanju i ciljevima."
  class="app-prose pt-10 sm:pt-14"  >

    <figure class="not-prose mb-10">
    <img
      src="/images/privatni_casovi_banner.png"
      alt="Privatni online časovi programiranja"
      width="1200"
      height="675"
      loading="eager"
      fetchpriority="high"
      class="border-border w-full rounded-xl border object-cover"
    />

    <figcaption class="text-muted-foreground mt-2 text-center text-sm">
      Privatni online časovi Pythona, Jave, JavaScripta, C/C++/C# i razvoja veb aplikacija. 062 100 5941.
    </figcaption>
  </figure>

    
    <section
      class="not-prose border-border bg-muted/20 mb-10 rounded-xl border p-6 sm:p-8"
    >
      <p class="m-0 text-lg leading-relaxed">
        Učite programiranje uz individualna objašnjenja, praktične
        primere i zadatke prilagođene vašem trenutnom nivou.
      </p>

      <ul class="mt-5 grid gap-2 sm:grid-cols-2">
        <li>✓ Individualan rad</li>
        <li>✓ Online časovi</li>
        <li>✓ Priprema ispita</li>
        <li>✓ Praktični zadaci i projekti</li>
      </ul>

      <div
  class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
  aria-label="Opcije za kontakt"
>
  <a
    href={whatsappURL}
    target="_blank"
    rel="noopener noreferrer"
    class="bg-accent text-accent-foreground hover:bg-accent/90 flex min-h-14 items-center justify-center gap-3 rounded-lg px-5 py-3 font-semibold transition-colors"
    aria-label={`Pošaljite WhatsApp poruku na ${CONTACT.phoneDisplay}`}
  >
    <Icon
      name="simple-icons:whatsapp"
      class="size-6 shrink-0"
      aria-hidden="true"
    />

    <span class="text-left">
      WhatsApp

      <span class="block text-sm opacity-80">
        {CONTACT.phoneDisplay}
      </span>
    </span>
  </a>

  <a
    href={getViberURL()}
    class="border-border hover:border-accent hover:text-accent flex min-h-14 items-center justify-center gap-3 rounded-lg border px-5 py-3 font-semibold transition-colors"
    aria-label={`Kontaktirajte Darka preko Vibera na ${CONTACT.phoneDisplay}`}
  >
    <Icon
      name="simple-icons:viber"
      class="size-6 shrink-0"
      aria-hidden="true"
    />

    <span class="text-left">
      Viber

      <span class="block text-sm opacity-70">
        {CONTACT.phoneDisplay}
      </span>
    </span>
  </a>

  <a
    href={`tel:${CONTACT.phoneHref}`}
    class="border-border hover:border-accent hover:text-accent flex min-h-14 items-center justify-center gap-3 rounded-lg border px-5 py-3 font-semibold transition-colors"
    aria-label={`Pozovite Darka na ${CONTACT.phoneDisplay}`}
  >
    <Icon
      name="tabler:phone"
      class="size-6 shrink-0"
      aria-hidden="true"
    />

    <span class="text-left">
      Pozovite

      <span class="block text-sm opacity-70">
        {CONTACT.phoneDisplay}
      </span>
    </span>
  </a>
</div>
    </section>

    <!-- ============================================= -->
    <!-- NEW: O meni / trust section                    -->
    <!-- ============================================= -->
    <section
      class="not-prose border-border mb-12 rounded-xl border p-6 sm:p-8"
    >
      <div class="grid gap-6 sm:grid-cols-[auto_1fr] sm:items-center">
        <img
          src="/images/profile-pic.png"
          alt="Darko Dekan"
          width="140"
          height="140"
          loading="lazy"
          class="border-border mx-auto size-28 rounded-full border object-cover sm:mx-0 sm:size-32"
        />

        <div>
          <h2 class="mt-0 text-xl font-semibold">O meni</h2>

          <!-- TODO: replace with your real bio — years of experience, education, relevant work -->
          <p class="mb-0">
            Zovem se Darko Dekan i bavim se profesionalno programiranjem i
            podučavanjem već 8+ godina. Do sada sam radio sa
            1000+ učenika, studenata i programera na pripremi ispita, kolokvijuma, intervjua
            i praktičnih projekata.
          </p>
        </div>
      </div>
    </section>

    <h2>Kome su časovi namenjeni?</h2>

    <p>
      Časovi su namenjeni početnicima, srednjoškolcima, studentima i
      svima koji žele da bolje razumeju programiranje ili unaprede
      praktično znanje.
    </p>

    <ul>
      <li>početnicima koji prvi put uče programiranje;</li>
      <li>studentima koji pripremaju kolokvijum ili ispit;</li>
      <li>učenicima kojima je potrebna pomoć sa školskim gradivom;</li>
      <li>ljudima koji prelaze na novi programski jezik;</li>
      <li>kandidatima koji se pripremaju za tehnički intervju;</li>
      <li>studentima kojima je potrebno objašnjenje projekta.</li>
    </ul>

    <h2>Programski jezici i oblasti</h2>
<div class="not-prose my-7 grid gap-4 sm:grid-cols-2">
  <section
    class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors"
  >
    <div class="mb-4 flex items-center gap-3">
      <span
        class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg"
      >
        <Icon
          name="simple-icons:python"
          class="size-6"
          aria-hidden="true"
        />
      </span>

      <h3 class="text-accent m-0 text-xl font-semibold">
        Python
      </h3>
    </div>

    <p class="mb-0">
      Osnove jezika, funkcije, klase, objektno orijentisano
      programiranje, algoritmi, rad sa podacima, automatizacija,
      Flask i Django.
    </p>
  </section>

  <section
    class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors"
  >
    <div class="mb-4 flex items-center gap-3">
      <span
        class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg"
      >
        <Icon
          name="simple-icons:openjdk"
          class="size-6"
          aria-hidden="true"
        />
      </span>

      <h3 class="text-accent m-0 text-xl font-semibold">
        Java
      </h3>
    </div>

    <p class="mb-0">
      Osnove Jave, klase i objekti, nasleđivanje, interfejsi,
      kolekcije, izuzeci, algoritmi i osnove Springa.
    </p>
  </section>

  <section
    class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors"
  >
    <div class="mb-4 flex items-center gap-3">
      <span
        class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg"
      >
        <Icon
          name="simple-icons:cplusplus"
          class="size-6"
          aria-hidden="true"
        />
      </span>

      <h3 class="text-accent m-0 text-xl font-semibold">
        C/C++
      </h3>
    </div>

    <p class="mb-0">
      Osnove jezika C i C++, pokazivači, rad sa memorijom, nizovi,
      strukture, funkcije, klase i objekti, objektno orijentisano
      programiranje, STL, algoritmi i strukture podataka.
    </p>
  </section>

  
   <section
    class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors"
  >
    <div class="mb-4 flex items-center gap-3">
      <span
        class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg"
      >
        <Icon
          name="simple-icons:csharp"
          class="size-6"
          aria-hidden="true"
        />
      </span>

      <h3 class="text-accent m-0 text-xl font-semibold">
        C#
      </h3>
    </div>

    <p class="mb-0">
      Osnove jezika C#, objektno orijentisano programiranje, kolekcije,
      LINQ, rad sa izuzecima, osnove .NET-a i razvoj konzolnih i
      desktop aplikacija.
    </p>
  </section>
  <section
    class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors"
  >
    <div class="mb-4 flex items-center gap-3">
      <span
        class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg"
      >
        <Icon
          name="simple-icons:javascript"
          class="size-6"
          aria-hidden="true"
        />
      </span>

      <h3 class="text-accent m-0 text-xl font-semibold">
        JavaScript
      </h3>
    </div>

    <p class="mb-0">
      Osnove JavaScripta, funkcije, nizovi i objekti, DOM, događaji,
      asinhrono programiranje, rad sa API-jima, frontend razvoj,
      Node.js i osnove Reacta.
    </p>
  </section>
  <section
    class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors"
  >
    <div class="mb-4 flex items-center gap-3">
      <span
        class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg"
      >
        <Icon
          name="tabler:world-www"
          class="size-7"
          aria-hidden="true"
        />
      </span>

      <h3 class="text-accent m-0 text-xl font-semibold">
        Razvoj veb aplikacija
      </h3>
    </div>

    <p class="mb-0">
      HTML, CSS, izrada frontend i backend dela aplikacije, rad sa
      API-jima, baze podataka, autentifikacija korisnika, Django,
      Flask, Spring Boot i postavljanje (deployment) gotove aplikacije.
    </p>
  </section>

  <section
    class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors"
  >
    <div class="mb-4 flex items-center gap-3">
      <span
        class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg"
      >
        <Icon
          name="tabler:binary-tree-2"
          class="size-7"
          aria-hidden="true"
        />
      </span>

      <h3 class="text-accent m-0 text-xl font-semibold">
        Algoritmi i strukture podataka
      </h3>
    </div>

    <p class="mb-0">
      Analiza problema, složenost algoritama, rekurzija, sortiranje,
      pretraga, liste, stekovi, redovi, stabla i grafovi.
    </p>
  </section>

  <section
    class="border-border hover:border-accent/60 rounded-lg border p-5 transition-colors"
  >
    <div class="mb-4 flex items-center gap-3">
      <span
        class="bg-accent/10 text-accent flex size-11 shrink-0 items-center justify-center rounded-lg"
      >
        <Icon
          name="tabler:school"
          class="size-7"
          aria-hidden="true"
        />
      </span>

      <h3 class="text-accent m-0 text-xl font-semibold">
        Fakultetski zadaci
      </h3>
    </div>

    <p class="mb-0">
      Priprema kolokvijuma i ispita, razumevanje postojećeg koda,
      debagovanje i objašnjenje koncepata iz gradiva.
    </p>
  </section>
 
</div>

    <h2>Kako izgledaju časovi?</h2>

    <ol>
      <li>
        Pre časa mi pošaljete oblast, zadatak ili materijal koji učite.
      </li>

      <li>
        Proveravamo šta već razumete i gde se tačno pojavljuje problem.
      </li>

      <li>
        Koncept objašnjavam na jednostavnijem, konkretnom primeru.
      </li>

      <li>
        Zajedno rešavamo zadatke i proveravamo da li možete samostalno
        primeniti postupak.
      </li>
    </ol>

    <p>
      Cilj časa nije samo da dobijete gotovo rešenje. Važno je da
      razumete postupak i da posle časa možete samostalno rešavati
      slične probleme.
    </p>

    <h2>Online način rada</h2>

    <p>
      Časovi se održavaju online uz razgovor, deljenje ekrana i
      zajedničko pisanje koda. Možemo raditi u razvojnom okruženju koje
      već koristite na fakultetu ili instalirati odgovarajuće alate pre
      prvog časa.
    </p>

    <!-- ============================================= -->
    <!-- NEW: Cena section                               -->
    <!-- ============================================= -->
    <section
      class="not-prose border-border bg-muted/20 my-12 rounded-xl border p-6 sm:p-8"
    >
      <h2 class="mt-0 text-xl font-semibold">Cena časa</h2>

      <!-- TODO: replace with your real price / range -->
      <p class="mb-2 text-lg">
        Cena časa zavisi od oblasti i učestalosti, i kreće se od&nbsp; 
        <strong>1800 din</strong> za 60 min. I povoljnija opcija&nbsp;
        <strong>2500 din</strong> za 90 min.
      </p>

      <p class="text-muted-foreground mb-0 text-sm">
        Tačnu cenu i predlog dinamike dobijate nakon kratkog razgovora
        o vašim ciljevima.
      </p>
    </section>

    <!-- ============================================= -->
    <!-- NEW: Testimonials section                       -->
    <!-- ============================================= -->
    <section class="not-prose my-12">
      <h2 class="mb-6 text-xl font-semibold">Šta kažu polaznici</h2>

      <div class="grid gap-4 sm:grid-cols-3">
        {testimonials.map((t) => (
          <blockquote class="border-border flex h-full flex-col justify-between rounded-lg border p-5">
            <p class="mb-4 text-sm leading-relaxed italic">
              "{t.quote}"
            </p>

            <footer class="text-muted-foreground text-sm">
              <span class="font-semibold not-italic">{t.name}</span>
              {t.context && <span> — {t.context}</span>}
            </footer>
          </blockquote>
        ))}
      </div>
    </section>

    <h2>Šta poslati pre prvog časa?</h2>

    <p>U prvoj poruci napišite:</p>

    <ul>
      <li>koji programski jezik ili predmet učite;</li>
      <li>koju školu ili fakultet pohađate, ako je relevantno;</li>
      <li>koju oblast trenutno radite;</li>
      <li>kada imate kolokvijum ili ispit;</li>
      <li>koliko prethodnog iskustva imate.</li>
    </ul>

    <section
      class="not-prose border-border mt-12 rounded-xl border p-6 sm:p-8"
    >
      <h2 class="mt-0 text-2xl font-semibold">
        Zainteresovani ste za čas?
      </h2>

      <p class="mt-3 mb-6">
        Pošaljite mi šta trenutno učite i šta želite da postignete.
        Odgovoriću vam sa predlogom načina rada i dostupnim terminima.
      </p>

    
      <div
  class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
  aria-label="Opcije za kontakt"
>
  <a
    href={whatsappURL}
    target="_blank"
    rel="noopener noreferrer"
    class="bg-accent text-accent-foreground hover:bg-accent/90 flex min-h-14 items-center justify-center gap-3 rounded-lg px-5 py-3 font-semibold transition-colors"
    aria-label={`Pošaljite WhatsApp poruku na ${CONTACT.phoneDisplay}`}
  >
    <Icon
      name="simple-icons:whatsapp"
      class="size-6 shrink-0"
      aria-hidden="true"
    />

    <span class="text-left">
      WhatsApp

      <span class="block text-sm opacity-80">
        {CONTACT.phoneDisplay}
      </span>
    </span>
  </a>

  <a
    href={getViberURL()}
    class="border-border hover:border-accent hover:text-accent flex min-h-14 items-center justify-center gap-3 rounded-lg border px-5 py-3 font-semibold transition-colors"
    aria-label={`Kontaktirajte Darka preko Vibera na ${CONTACT.phoneDisplay}`}
  >
    <Icon
      name="simple-icons:viber"
      class="size-6 shrink-0"
      aria-hidden="true"
    />

    <span class="text-left">
      Viber

      <span class="block text-sm opacity-70">
        {CONTACT.phoneDisplay}
      </span>
    </span>
  </a>

  <a
    href={`tel:${CONTACT.phoneHref}`}
    class="border-border hover:border-accent hover:text-accent flex min-h-14 items-center justify-center gap-3 rounded-lg border px-5 py-3 font-semibold transition-colors"
    aria-label={`Pozovite Darka na ${CONTACT.phoneDisplay}`}
  >
    <Icon
      name="tabler:phone"
      class="size-6 shrink-0"
      aria-hidden="true"
    />

    <span class="text-left">
      Pozovite

      <span class="block text-sm opacity-70">
        {CONTACT.phoneDisplay}
      </span>
    </span>
  </a>
</div>
    </section>
  </Main>

  <Footer />
</Layout>