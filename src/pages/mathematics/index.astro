---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";

import config from "@/config";

const allPosts = await getCollection("posts");

const mathematicsPosts = getSortedPosts(allPosts).filter(post =>
  post.id.startsWith("mathematics/")
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: config.site.timezone,
  });
---

<Layout
  title="Mathematics | Darko Dekan"
  description="Articles about pure mathematics, including topology, analysis, algebra, geometry, and number theory."
>
  <Header />

  <main id="main-content" class="app-layout flex-1">
    <section class="py-10">
      <header class="mb-10">
        <h1 class="text-3xl font-bold sm:text-4xl">
          Mathematics
        </h1>

        <p class="mt-4 max-w-2xl text-lg text-foreground/75">
          Articles and explanations about pure mathematics, including
          topology, analysis, algebra, geometry, and number theory.
        </p>
      </header>

      {
        mathematicsPosts.length > 0 ? (
          <ul class="space-y-8">
            {mathematicsPosts.map(post => (
              <li class="border-border border-b pb-8">
                <article>
                  <a
                    href={getPostUrl(
                      post.id,
                      post.filePath,
                      config.site.lang
                    )}
                    class="group inline-block"
                  >
                    <h2 class="text-2xl font-semibold group-hover:text-accent">
                      {post.data.title}
                    </h2>
                  </a>

                  <p class="mt-3 text-foreground/75">
                    {post.data.description}
                  </p>

                  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-foreground/65">
                    <time datetime={post.data.pubDatetime.toISOString()}>
                      {formatDate(
                        post.data.modDatetime ??
                          post.data.pubDatetime
                      )}
                    </time>

                    {post.data.tags.length > 0 && (
                      <span>
                        {post.data.tags.join(" · ")}
                      </span>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <p>No mathematics articles have been published yet.</p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>