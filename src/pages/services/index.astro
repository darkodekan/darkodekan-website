---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Icon } from "astro-icon/components";
import ContactForm from "@/components/ContactForm.astro";

const siteUrl = "https://darkodekan.com";
const canonicalUrl = `${siteUrl}/services`;
const alternateSrUrl = `${siteUrl}/sr/services`;
const pageTitle = "Programming Services | Automation, Web Development & Debugging | Darko Dekan";
const pageDescription = "Professional programming services including automation, web development, and debugging. Experienced with Python, Java, and other technologies.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Software Development Services",
  "provider": {
    "@type": "Person",
    "name": "Darko Dekan",
    "url": siteUrl
  },
  "areaServed": "Worldwide",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Programming Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Automation",
          "description": "Automating repetitive tasks, workflows, and data processing with custom scripts and tools."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Web Development",
          "description": "Custom websites and web applications, from simple landing pages to full-stack projects."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Debugging",
          "description": "Identifying and fixing issues in Python, Java, and other codebases."
        }
      }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="sr" href={alternateSrUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="sr_RS" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Header />

  <main id="main-content" class="app-layout flex-1 pt-10">
    <section class="py-10">
      <h1 class="text-4xl font-bold sm:text-5xl">Programming Services</h1>
      <p class="mt-6 max-w-2xl text-xl text-foreground/80 leading-relaxed">
        Practical, reliable software help for individuals and businesses. From automating 
        repetitive tasks to building web applications and tracking down stubborn bugs, 
        I bring hands-on experience across Python, Java, and other technologies.
      </p>

      <!-- Service Cards -->
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="border-border rounded-2xl border p-8">
          <Icon name="tabler:robot" class="size-8 text-accent" />
          <h2 class="mt-4 text-2xl font-semibold">Automation</h2>
          <p class="mt-3 text-foreground/70">Save time by automating repetitive tasks, workflows, and data processing with custom scripts and tools.</p>
        </div>

        <div class="border-border rounded-2xl border p-8">
          <Icon name="tabler:code" class="size-8 text-accent" />
          <h2 class="mt-4 text-2xl font-semibold">Web Development</h2>
          <p class="mt-3 text-foreground/70">Custom websites and web applications built with modern tools, from simple landing pages to full-stack projects.</p>
        </div>

        <div class="border-border rounded-2xl border p-8">
          <Icon name="tabler:bug" class="size-8 text-accent" />
          <h2 class="mt-4 text-2xl font-semibold">Debugging</h2>
          <p class="mt-3 text-foreground/70">Stuck on a bug that won't go away? I help identify and fix issues in Python, Java, and other codebases.</p>
        </div>
      </div>

      <!-- Credibility Section -->
      <div class="mt-16 border-t pt-10">
        <h2 class="text-2xl font-semibold">Why work with me?</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          <div>
            <h3 class="font-semibold text-lg">Practical Solutions</h3>
            <p class="text-sm text-foreground/70 mt-1">Focused on solving your actual problem, not overengineering.</p>
          </div>
          <div>
            <h3 class="font-semibold text-lg">Clear Communication</h3>
            <p class="text-sm text-foreground/70 mt-1">Regular updates and explanations in plain language, no jargon overload.</p>
          </div>
          <div>
            <h3 class="font-semibold text-lg">Multi-Technology Experience</h3>
            <p class="text-sm text-foreground/70 mt-1">Comfortable across Python, Java, and other languages and frameworks as needed.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  

  <Footer />
</Layout>